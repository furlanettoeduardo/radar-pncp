<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.furlanettoeduardo</groupId>
    <artifactId>radar-pncp</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>radar-ingestion</artifactId>
  <name>radar-ingestion</name>
  <description>PNCP client, scheduler, SQS producer and consumer, LLM enrichment.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.furlanettoeduardo</groupId>
      <artifactId>radar-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.furlanettoeduardo</groupId>
      <artifactId>radar-shared</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Resilience4j core only, not resilience4j-spring-boot3. The Spring integration works through
      AOP proxies, and a call made from inside a virtual thread subtask does not go through one:
      the annotations would silently do nothing. Decoration here is programmatic, and the core
      modules cost a fraction of the heap.
    -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <resilience4j.version>2.4.0</resilience4j.version>
    <wiremock.version>3.13.2</wiremock.version>
  </properties>

  <build>
    <plugins>
      <!--
        StructuredTaskScope is a preview API in Java 21, so the flag is needed at compile time and
        at run time. Three places carry it: here, the test JVMs below, and JAVA_TOOL_OPTIONS in the
        Dockerfile. Miss one and the failure is a NoClassDefFoundError at startup, not a build
        error. See docs/adr/0008.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>--enable-preview</arg>
            <arg>-Xlint:all,-serial,-processing,-preview</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>--enable-preview</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>--enable-preview</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
