# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
# google-java-format: 2-space indent, 100-column limit
indent_size = 2
max_line_length = 100

[*.{xml,yml,yaml,json}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
